<title>Shadowrun Script Editor</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: a workbench. Map canvas fills the left, a fixed-width inspector + block catalogue on the right; stacks on phones.
   Single dark look on purpose: map art is judged against black, like the game itself. */
:root {
  --bg: #0d0f14; --panel: #151922; --panel-2: #1c2130; --line: #2a3142; --fg: #e4e7ef; --muted: #8d95a8;
  --accent: #ff4f9a; --accent-ink: #1a0610; --cyan: #3fd6e8; --green: #59e08a; --yellow: #f2c94c; --red: #ff6b5e;
  --display: "Chakra Petch", "Segoe UI", system-ui, sans-serif;
  --body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  color-scheme: dark;
}
html, body { height: 100%; }
[hidden] { display: none !important; }
body { background: var(--bg); color: var(--fg); font: 14px/1.45 var(--body); }
.wrap { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 14px 24px; display: flex; flex-direction: column; gap: 12px; min-height: 100%; box-sizing: border-box; }
header { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
h1 { font: 600 22px/1 var(--display); letter-spacing: .02em; margin: 0; }
h1 span { color: var(--accent); }
h2 { font: 600 13px/1.2 var(--display); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }
.grow { flex: 1 1 auto; }
button, .btn, select, input { font: inherit; color: var(--fg); }
button, .btn { background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; padding: 6px 11px; cursor: pointer; white-space: nowrap; }
button:hover:not(:disabled), .btn:hover { border-color: var(--muted); }
button:disabled { opacity: .45; cursor: not-allowed; }
button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
button[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
button:focus-visible, input:focus-visible, select:focus-visible, .btn:focus-within { outline: 2px solid var(--cyan); outline-offset: 2px; }
input[type="number"], input[type="search"], select { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 5px 8px; min-width: 0; }
input[type="number"] { width: 5.5em; font-family: var(--mono); }
.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.muted { color: var(--muted); }
.toolbar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.sep { width: 1px; align-self: stretch; background: var(--line); margin: 0 4px; }
main { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 12px; flex: 1 1 auto; min-height: 0; }
@media (max-width: 900px) { main { grid-template-columns: minmax(0, 1fr); } }
.stage { background: #000; border: 1px solid var(--line); border-radius: 8px; overflow: auto; position: relative; min-height: 320px; max-height: calc(100vh - 170px); }
.stage canvas { display: block; image-rendering: pixelated; }
#over { position: absolute; left: 0; top: 0; }
aside { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.field { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); }
.meters { display: grid; grid-template-columns: auto 1fr auto; gap: 6px 10px; align-items: center; font-size: 12px; }
.bar { height: 6px; background: var(--bg); border-radius: 3px; overflow: hidden; }
.bar i { display: block; height: 100%; background: var(--cyan); }
.bar.warn i { background: var(--yellow); } .bar.over i { background: var(--red); }
.cat { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; max-height: 420px; overflow-y: auto; padding-right: 2px; }
.blk { background: #000; border: 1px solid var(--line); border-radius: 6px; padding: 4px; display: flex; flex-direction: column; gap: 2px; align-items: stretch; cursor: pointer; text-align: left; }
.blk canvas { width: 100%; aspect-ratio: 4 / 3; image-rendering: pixelated; }
.blk span { font: 11px var(--mono); color: var(--muted); }
.blk.used span { color: var(--accent); }
.drop { border: 2px dashed var(--line); border-radius: 10px; padding: 20px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 24px; align-items: center; }
@media (max-width: 760px) { .drop { grid-template-columns: minmax(0, 1fr); } }
.drop.hot { border-color: var(--accent); }
.drop img { width: 100%; border-radius: 6px; border: 1px solid var(--line); image-rendering: pixelated; }
.drop ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; max-width: 60ch; }
.drop p { margin: 0; max-width: 62ch; }
.badge { font: 500 11px var(--mono); padding: 2px 6px; border-radius: 4px; background: var(--panel-2); border: 1px solid var(--line); }
.badge.edit { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.legend { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: var(--muted); }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
.msg { font-size: 13px; padding: 8px 10px; border-radius: 6px; background: var(--panel-2); border-left: 3px solid var(--cyan); }
.msg.err { border-left-color: var(--red); } .msg.ok { border-left-color: var(--green); }
.keys { font-size: 12px; color: var(--muted); display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; }
kbd { font: 11px var(--mono); background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; color: var(--fg); }
#mapsel { max-width: 340px; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
@media (prefers-reduced-motion: no-preference) { .bar i { transition: width .2s; } }

.modes { display: flex; gap: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.modes button { border: 0; border-radius: 0; border-right: 1px solid var(--line); padding: 7px 14px; font-family: var(--display); font-weight: 600; letter-spacing: .03em; }
.modes button:last-child { border-right: 0; }
.modes button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
.pal { display: grid; grid-template-columns: repeat(auto-fill, minmax(66px, 1fr)); gap: 4px; max-height: 360px; overflow-y: auto; }
.pal button { padding: 3px; background: #000; display: flex; flex-direction: column; align-items: center; gap: 2px; font: 10px var(--mono); color: var(--muted); }
.pal button canvas { width: 64px; height: 32px; image-rendering: pixelated; }
.pal button[aria-pressed="true"] { outline: 2px solid var(--accent); background: #000; color: var(--accent); }
.list { display: flex; flex-direction: column; gap: 2px; max-height: 300px; overflow-y: auto; }
.list button { text-align: left; display: flex; gap: 8px; align-items: baseline; padding: 4px 8px; background: transparent; border-color: transparent; }
.list button[aria-pressed="true"] { background: var(--panel-2); color: var(--fg); border-color: var(--accent); }
.list button .mono { color: var(--muted); font-size: 12px; }
.list button.off { opacity: .5; text-decoration: line-through; }
.grid6 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.grid6 input { width: 100%; box-sizing: border-box; }
select.wide { width: 100%; }
